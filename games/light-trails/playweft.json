{
  "manifest_version": 1,
  "id": "/light-trails/",
  "version": "1.3.2",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Light Trails",
  "name_localized": {
    "zh-CN": "光尾蛇"
  },
  "description": "Choose a direction. Avoid every trail. Outlast your friend.",
  "description_localized": {
    "zh-CN": "双人光轨对决。躲避障碍与轨迹，生存至最后。"
  },
  "categories": [
    "games",
    "arcade"
  ],
  "icons": [
    {
      "src": "../light-trails.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#081416",
  "theme_color": "#081416",
  "orientation": "landscape",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "live"
      }
    }
  },
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json"
}
